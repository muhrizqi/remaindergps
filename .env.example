# Database
DATABASE_URL=postgres://gps_user:gps_pass@postgres:5432/gps_pulsa

# Server
PORT=3000
BASE_URL=https://gps.lewat.web.id
JWT_SECRET=ganti-dengan-random-string-panjang

# WAHA (instance yang sudah ada di infrastruktur lewat.web.id)
WAHA_BASE_URL=https://waha.lewat.web.id
WAHA_API_KEY=isi-api-key-waha
WAHA_SESSION=default

# Nomor WA kamu sendiri (admin) yang menerima reminder harian
# format: 62xxxxxxxxxx@c.us
ADMIN_WA_NUMBER=6281234567890@c.us

# Jika true, sistem juga otomatis kirim pesan tagihan langsung ke kontak_pemilik
# Kalau false, sistem hanya mengingatkan kamu (admin) supaya kamu yang menagih manual
AUTO_BILL_CUSTOMER=false

# Jam cron harian (format cron, default jam 7 pagi WIB)
CRON_SCHEDULE=0 7 * * *
TIMEZONE=Asia/Jakarta

# Batas jumlah diisi sebelum dianggap harus perpanjangan (28 hari x 13 = 364 hari ~ 1 tahun)
MAX_FILL_COUNT=13

# Jumlah hari siklus isi pulsa
FILL_CYCLE_DAYS=28
