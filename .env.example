PORT=3000
NODE_ENV=production
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=ganti-dengan-string-acak-panjang
SESSION_SECRET=ganti-dengan-string-acak-lain

# Login dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=abcd1234

# WAHA
WAHA_BASE_URL=https://waha.lewat.web.id
WAHA_API_KEY=isi-api-key-waha
WAHA_SESSION=default
ADMIN_WA_NUMBER=628xxxxxxxxxx@c.us

# URL publik aplikasi (dipakai untuk link di pesan WhatsApp)
